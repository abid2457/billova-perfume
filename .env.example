# ─── Supabase (Required) ──────────────────────────────────────────────────────
# Copy from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── WhatsApp (Optional — future upgrade) ────────────────────────────────────
# Leave empty to use the default wa.me web link (current mode)
# Set to "cloud" and add credentials below to enable WhatsApp Business API
VITE_WHATSAPP_MODE=web
VITE_WA_API_TOKEN=
VITE_WA_PHONE_ID=
